.category-heading
  a.back-link href="/#categories" ← All categories
  .category-heading-line
    h1 = @tag_name
    p = "#{@category_repos.size} #{@category_repos.size == 1 ? 'repository' : 'repositories'}"

.grid.repository-grid
  - @category_repos.each do |repo|
    article.card.repository-card
      .repository-copy
        h2
          a href="https://github.com/#{repo['org'] || 'DannyBen'}/#{repo['key']}" = repo['name']
        p = repo['summary']
      nav.repository-tags aria-label="Categories for #{repo['name']}"
        - repo['tags'].each do |tag|
          a.tag href="/#{tag}/" aria-current=('page' if tag == @tag) = tags[tag]
