doctype html
html lang="en"
  head
    meta charset="UTF-8"
    meta name="viewport" content="width=device-width, initial-scale=1"
    meta name="color-scheme" content="light dark"
    title 
      - if @tag_name
        = "#{@tag_name}: Open Source Projects by @DannyBen"
      - else
        = "Open Source Projects by @DannyBen"
    link href=asset_url('/assets/css/bonsai.min.css') rel="stylesheet"
    link href="/assets/css/main-#{css_fingerprint}.css" rel="stylesheet"
    script src=asset_url('/assets/js/theme.js')
    script defer=true src="https://analytics.dannyb.co/script.js" data-website-id="5bb5b1d9-aef1-459c-962e-f8f5a4384814"

  body id="top"
    header.site-header
      a.home-link href="/" aria-label="My GitHub home"
        img.github-logo src="/assets/img/github.png" alt="GitHub" width="1200" height="300"
      .site-tools
        == slim 'theme-selector'
      p.collection-meta
        span = "#{repos.size} projects"
        a href="/#categories" = "#{index_data.size} categories"
        a href="https://github.com/DannyBen" @DannyBen

    main == yield
    == slim 'footer'
    script src=asset_url('/assets/js/categories.js') defer=true
    script src=asset_url('/assets/js/outbound-links.js')

